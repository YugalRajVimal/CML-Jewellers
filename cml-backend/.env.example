PORT=5000
NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/cml-jewellers

JWT_ACCESS_SECRET=replace_with_strong_secret
JWT_REFRESH_SECRET=replace_with_strong_secret
JWT_ADMIN_ACCESS_SECRET=replace_with_strong_secret

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ADMIN_ACCESS_EXPIRES_IN=1d

EMAIL_OTP_ENABLED=true
SMS_OTP_ENABLED=true

SMTP_EMAIL=
SMTP_PASSWORD=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox

CORS_ORIGIN_CLIENT=http://localhost:3000
CORS_ORIGIN_ADMIN=http://localhost:3001

OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

SUPER_ADMIN_EMAIL=admin@cmljewellers.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ============================================================
# SHIPROCKET
# ============================================================

# sandbox OR production
SHIPROCKET_ENVIRONMENT=sandbox

# ============================================================
# PRODUCTION
# ============================================================

SHIPROCKET_PRODUCTION_BASE_URL=https://apiv2.shiprocket.in/v1/external

SHIPROCKET_PRODUCTION_EMAIL=
SHIPROCKET_PRODUCTION_PASSWORD=

# ============================================================
# SANDBOX
# ============================================================

# Put the exact Sandbox API base URL provided by Shiprocket
SHIPROCKET_SANDBOX_BASE_URL=

# Put the Sandbox Bearer token/API token provided by Shiprocket
SHIPROCKET_SANDBOX_TOKEN=

# ============================================================
# PICKUP
# ============================================================

SHIPROCKET_PICKUP_LOCATION=Home
SHIPROCKET_PICKUP_PINCODE=500006

# ============================================================
# WEBHOOK
# ============================================================

SHIPROCKET_WEBHOOK_SECRET=

# ============================================================
# COD
# ============================================================

COD_DEFAULT_ENABLED=false